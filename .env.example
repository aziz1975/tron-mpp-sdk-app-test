# Nile network
TRON_FULL_HOST=https://nile.trongrid.io
TRON_PRO_API_KEY=

# Nile USDT — 6 decimals
TRON_TOKEN_ADDRESS=TXYZopYRdj2D9XRtbG411XZZ3kM5VkAeBf

# Wallet receiving the USDT payment. The merchant.
TRON_RECIPIENT_ADDRESS=TFeVqdqL5m38MjQau5dSe9uFmYwJWyCLQy

# Wallet owning and paying the USDT. Paying the product price. The buyer.
TRON_PAYER_PRIVATE_KEY=TWtfUYRLfA4b61eJ3wwHmYcieV14rUTMCW

# Server secret — Generate a secret with openssl rand -base64 32 and put the result in MPP_SECRET_KEY.
MPP_SECRET_KEY=2222222222222222222222222222

# Select one credential for both intents: permit2 works for charge and session.
# transaction is supported for charge only.
CREDENTIAL_TYPE=permit2

# Nile Permit2 contract
TRON_PERMIT2_ADDRESS=TYQuuhGbEMxF7nZxUHV3uHJxAVVAegNU9h

# Server wallet submitting the Permit2 transaction
# This address must belong to the private key below
# In this test the spender and the relayer are the same. Sponsoring the gas fee for the Permit2 transaction.
TRON_PERMIT2_SPENDER_ADDRESS=TQGfKPHs3AwiBT44ibkCU64u1G4ttojUXU
TRON_RELAYER_PRIVATE_KEY=TQGfKPHs3AwiBT44ibkCU64u1G4ttojUXU

# Payment: 1 USDT
PAYMENT_AMOUNT_ATOMIC=1000000

# Maximum payment and approval amount: 1 USDT
MAX_PAYMENT_AMOUNT_ATOMIC=1000000

# Local server
PORT=3001

# Confirmation settings
TRANSACTION_TIMEOUT_MS=90000
# Delay between transaction-confirmation checks.
POLL_INTERVAL_MS=1000
# Required number of block confirmations before accepting a transaction as confirmed.
MIN_CONFIRMATIONS=1

# For session intent
# Session intent requires CREDENTIAL_TYPE=permit2.
# Private key for TRON_RECIPIENT_ADDRESS. Optional only when the relayer is that merchant.
TRON_PAYEE_PRIVATE_KEY=TFeVqdqL5m38MjQau5dSe9uFmYwJWyCLQy

SESSION_PORT=3001
# Directory holding persistent client/server journals and process locks.
SESSION_STATE_DIR=.data/session
# Token price charged for one delivered message, expressed in atomic units.
SESSION_UNIT_AMOUNT_ATOMIC=100000
# Initial token deposit made when opening a channel.
SESSION_DEPOSIT_ATOMIC=1000000
# Additional funds that can be added to the channel. Default additional deposit for `session:topup` and `session:merge`
SESSION_TOP_UP_ATOMIC=1000000
# Maximum total deposit allowed in the channel. Maximum total channel funding and the target token allowance granted to Permit2.
SESSION_MAX_DEPOSIT_ATOMIC=2000000
# Maximum cumulative amount that can be transferred in the channel. Maximum cumulative payment amount the client will authorize through vouchers.
SESSION_MAX_CUMULATIVE_ATOMIC=2000000
# Number of stream units for the session. 
# A stream is one HTTP response that delivers several messages progressively, instead of returning just one message.
SESSION_STREAM_UNITS=4
