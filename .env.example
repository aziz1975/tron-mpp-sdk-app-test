# Nile testnet USDT. This address is specific to Nile.
TRON_FULL_HOST=https://nile.trongrid.io
TRON_PRO_API_KEY=
TRON_TOKEN_ADDRESS=TXYZopYRdj2D9XRtbG411XZZ3kM5VkAeBf
TRON_RECIPIENT_ADDRESS=
TRON_PAYER_PRIVATE_KEY=
MPP_SECRET_KEY=

# charge intent only. Select exactly one credential; there is no fallback.
CHARGE_CREDENTIAL_TYPE=transaction
# Required only when CHARGE_CREDENTIAL_TYPE=permit2.
# Nile Permit2: https://docs.sun.io/protocols/sunswap-v4/reference/contract/
TRON_PERMIT2_ADDRESS=TYQuuhGbEMxF7nZxUHV3uHJxAVVAegNU9h
# Address belonging to TRON_RELAYER_PRIVATE_KEY (the server's submitting account).
TRON_PERMIT2_SPENDER_ADDRESS=
TRON_RELAYER_PRIVATE_KEY=

# Integer token atomic units. For a six-decimal token, 1000000 = 1 token.
PAYMENT_AMOUNT_ATOMIC=1000000
MAX_PAYMENT_AMOUNT_ATOMIC=1000000
PORT=3000
TRANSACTION_TIMEOUT_MS=90000
POLL_INTERVAL_MS=1000
MIN_CONFIRMATIONS=1

# Permit2 session intent (independent of CHARGE_CREDENTIAL_TYPE).
# Deploy TronPaymentChannel from ../tron-mpp-sdk-contract with this token and Permit2.
TRON_SESSION_ESCROW_ADDRESS=
# Merchant key for TRON_RECIPIENT_ADDRESS. Optional only when the relayer is that merchant.
TRON_PAYEE_PRIVATE_KEY=
SESSION_PORT=3001
SESSION_STATE_DIR=.data/session
SESSION_UNIT_AMOUNT_ATOMIC=100000
SESSION_DEPOSIT_ATOMIC=1000000
SESSION_TOP_UP_ATOMIC=1000000
SESSION_MAX_DEPOSIT_ATOMIC=2000000
SESSION_MAX_CUMULATIVE_ATOMIC=2000000
SESSION_STREAM_UNITS=4
